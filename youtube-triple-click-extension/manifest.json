{
  "manifest_version": 3,
  "name": "YouTube Triple-Click Navigation",
  "description":  "Skip forward or backward 5 seconds by triple-clicking on the video player",
  "version": "1.0",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}